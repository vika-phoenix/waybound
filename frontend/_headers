# Cloudflare Pages response headers.
#
# These were a no-op for a while and are load-bearing again. The zone used to
# rewrite Cache-Control at the edge for static extensions (Caching ->
# Configuration -> Browser Cache TTL, set to 4 hours), downstream of the
# origin, so nothing written here survived. That is now "Respect Existing
# Headers", verified 2026-08-15:
#
#   kavkazland.com/mobile.css -> public, max-age=0, must-revalidate (REVALIDATED)
#
# So what follows actually reaches browsers. Check with a GET, not `curl -I` —
# Cloudflare only caches GET, so a HEAD request reports DYNAMIC regardless:
#
#   curl -s -o /dev/null -D - <url> | grep -iE 'cf-cache-status|cache-control'

# Webfonts carry Google's content-hashed filenames, so a file at a given path
# can never change — a new cut of a face arrives under a new name. That makes
# them safe to cache permanently, which matters here: self-hosting moved about
# 1.1 MB of woff2 onto our own origin, and without this every returning
# visitor would revalidate all of it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# The stylesheet that points at them is small and changes when a family or
# weight changes, so it revalidates like the rest.
/fonts.css
  Cache-Control: public, max-age=0, must-revalidate

# config.js carries the API hostname. A stale copy points the browser at the
# old backend and fails before the request leaves the machine, so this one in
# particular must never be cached.
/config.js
  Cache-Control: public, max-age=0, must-revalidate

/nav.js
  Cache-Control: public, max-age=0, must-revalidate

/toast.js
  Cache-Control: public, max-age=0, must-revalidate

/mobile.css
  Cache-Control: public, max-age=0, must-revalidate